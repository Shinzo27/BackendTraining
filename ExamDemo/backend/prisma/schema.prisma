// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 Int                  @id @default(autoincrement())
  name               String
  description        String
  price              Float
  image              String
  stock              Int
  saleProductDetaisl SaleProductDetails[] @relation(name: "saleProduct")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  Cart               Cart[]               @relation(name: "cartProduct")
}

model SalesData {
  id                 Int                  @id @default(autoincrement())
  userId             Int
  address            String
  city               String
  pincode            Int
  total              Float
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  saleProductDetails SaleProductDetails[] @relation(name: "saleId")
}

model SaleProductDetails {
  id        Int       @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  order     SalesData @relation(name: "saleId", fields: [orderId], references: [id])
  product   Product   @relation(name: "saleProduct", fields: [productId], references: [id])
}

model Cart {
  id         Int     @id @default(autoincrement())
  userId     Int
  productId  Int
  quantity   Int
  totalPrice Float
  product    Product @relation(name: "cartProduct", fields: [productId], references: [id])
}
